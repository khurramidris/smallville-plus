# MockLLM needs no variables and never imports a provider SDK.
# Configure these only after authorizing a paid run. Do not commit a .env file.
SIM_MODEL_DEEP=provider/deep-model-name
SIM_MODEL_FAST=provider/fast-model-name
SIM_MODEL_GM=provider/gm-model-name
SIM_EMBED_MODEL=provider/embedding-model-name
SIM_MAX_USD=1.00
SIM_MAX_TOKENS=1200
# JSON keys must match every selected completion model.
# Values are conservative USD PER TOKEN ceilings, not USD per million tokens.
# Replace the illustrative model names and prices with verified provider rates.
SIM_MODEL_PRICES={"provider/deep-model-name":{"input":"0.00001","output":"0.00003"},"provider/fast-model-name":{"input":"0.000001","output":"0.000003"},"provider/gm-model-name":{"input":"0.00001","output":"0.00003"}}
# Optional: select different model families for specific resident IDs.
SIM_MODEL_OVERRIDES={}
# Provider API keys must be injected into the process environment by the user.
# The program does not read or write key files, or print environment values.
